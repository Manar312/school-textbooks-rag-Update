# --- copy to .env and fill in ---
APP_ENV=dev            # prod => refuses weak JWT_SECRET (<32 chars) and CORS_ORIGINS=*                 # use "prod" on the server: it refuses a weak JWT_SECRET or CORS_ORIGINS=*
JWT_SECRET=change-me-to-a-long-random-string   # prod: openssl rand -hex 32
CORS_ORIGINS=*              # prod: https://your-school-site.com
API_WORKERS=2               # each worker loads the BGE models (~2GB RAM)

# Used by docker-compose (secrets for the infrastructure services)
POSTGRES_PASSWORD=change-me
FLOWER_USER=admin
FLOWER_PASSWORD=change-me
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Services (docker-compose service names are used inside containers)
# (inside docker these four are set by docker-compose.yml; set them here only for running without docker)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/schoolrag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
STORAGE_DIR=./storage

# ---- API keys ----
# FREE: create a Groq key (no credit card) at https://console.groq.com  -> API Keys
GROQ_API_KEY=gsk_...
# Optional alternatives (not needed for the free default setup):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A role can also use its own key: LLM_API_KEY / CONDENSE_API_KEY / VLM_API_KEY / EMBED_API_KEY

# =====================================================================================================
# Every role picks its own provider + model. Change these lines to switch models -- no code changes.
# See what is available:  docker compose exec api python -m app.cli providers
# Default setup uses free-tier or open-source components, subject to provider limits and terms.
# =====================================================================================================

# Answers: groq | gemini | anthropic | openai (openai + LLM_BASE_URL = any OpenAI-compatible server)
# llama-4-scout officially supports Arabic / French / English. Alternative on Groq: llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# LLM_BASE_URL=

# Question planner: rewrites follow-ups + routes the question to the right subject (one small call per question)
CONDENSE_PROVIDER=groq
CONDENSE_MODEL=llama-3.1-8b-instant

# Vision model that reads page images (needs image input: llama-4-scout on Groq's free tier)
VLM_PROVIDER=groq
VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Free tiers allow ~30 requests/minute: keep this at 1-2
VLM_CONCURRENCY=1

# Embeddings: bge_m3 (local, free, multilingual, dense+sparse hybrid) | openai (any OpenAI-compatible API, dense only)
# NOTE: changing the embedding model creates a NEW vector collection. Fill it with
#       POST /admin/books/{id}/reindex  (re-uses the saved page text: no VLM cost).
EMBED_PROVIDER=bge_m3
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# Reranker: bge (local, free) | none
RERANK_PROVIDER=bge
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Vector store / OCR fallback
VECTORSTORE_PROVIDER=qdrant
OCR_PROVIDER=tesseract
OCR_LANGUAGES=ara+eng+fra

# Extraction: auto | vlm | native
EXTRACTION_MODE=auto

# Multi-RAG router (subject routing). false => always search every subject of the student's grade
ROUTER_ENABLED=true
ROUTER_MAX_SUBJECTS=3
ROUTER_MIN_CONFIDENCE=0.5

# Per-student limits (admin can override per student) + one limit shared by ALL students (protects the free quota)
DEFAULT_DAILY_REQUESTS=60
DEFAULT_DAILY_TOKENS=150000
RATE_LIMIT_PER_MINUTE=12
GLOBAL_QUESTIONS_PER_MINUTE=15
